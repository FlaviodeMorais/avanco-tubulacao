            "dataType": "int64",
            "sourceColumn": "Ordem",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "#,0",
            "isHidden": true
