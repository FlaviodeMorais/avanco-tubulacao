              }
            ],
            "formatString": "#,0"
          },
          {
            "name": "Reparos",
            "dataType": "int64",
            "sourceColumn": "Reparos",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Reparo",
            "dataType": "double",
            "sourceColumn": "% Reparo",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "#,0.0"
          }
        ],
        "partitions": [
          {
            "name": "Reparos_Diametro",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Juntas = fnCarregar(\"juntas.json\"),",
                "    Tabela = Table.FromRecords(Juntas[reparos_por_diam]),",
                "    Renomeada = Table.RenameColumns(Tabela, {",
                "        {\"pol\", \"Diametro\"}, {\"total\", \"Juntas\"}, {\"reparos\", \"Reparos\"}, {\"pct\", \"% Reparo\"}}),",
                "    Tipos = Table.TransformColumnTypes(Renomeada, {",
                "        {\"Diametro\", type text}, {\"Juntas\", Int64.Type},",
                "        {\"Reparos\", Int64.Type}, {\"% Reparo\", type number}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Juntas_Curva",
        "columns": [
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Serie",
            "dataType": "string",
            "sourceColumn": "Serie",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Juntas",
            "dataType": "int64",
            "sourceColumn": "Juntas",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Juntas_Curva",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Juntas = fnCarregar(\"juntas.json\"),",
                "    Meses = Juntas[curve_months],",
                "    Soldadas = List.Transform(List.Positions(Meses), (i) => {Meses{i}, \"Soldadas\", Juntas[curve_sold]{i}}),",
                "    Liberadas = List.Transform(List.Positions(Meses), (i) => {Meses{i}, \"Liberadas END\", Juntas[curve_lib]{i}}),",
                "    Tabela = Table.FromRows(Soldadas & Liberadas, {\"Mes\", \"Serie\", \"Juntas\"}),",
                "    Tipos = Table.TransformColumnTypes(Tabela, {",
                "        {\"Mes\", type text}, {\"Serie\", type text}, {\"Juntas\", Int64.Type}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Juntas_Material",
        "columns": [
          {
            "name": "Mes",
            "dataType": "string",
            "sourceColumn": "Mes",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Material",
            "dataType": "string",
            "sourceColumn": "Material",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Juntas Soldadas",
            "dataType": "int64",
            "sourceColumn": "Juntas Soldadas",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Juntas_Material",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Juntas = fnCarregar(\"juntas.json\"),",
                "    Meses = Juntas[curve_months],",
                "    PorMaterial = Juntas[curve_sold_material],",
                "    Materiais = Record.FieldNames(PorMaterial),",
                "    Linhas = List.Combine(List.Transform(Materiais, (m) =>",
                "        let Valores = Record.Field(PorMaterial, m) in",
                "        List.Transform(List.Positions(Valores), (i) => {Meses{i}, m, Valores{i}}))),",
                "    Tabela = Table.FromRows(Linhas, {\"Mes\", \"Material\", \"Juntas Soldadas\"}),",
                "    Tipos = Table.TransformColumnTypes(Tabela, {",
                "        {\"Mes\", type text}, {\"Material\", type text}, {\"Juntas Soldadas\", Int64.Type}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Medidas",
        "columns": [
          {
            "name": "Coluna",
            "dataType": "int64",
            "sourceColumn": "Coluna",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Tabela = #table(type table [Coluna = Int64.Type], {{1}})",
                "in",
                "    Tabela"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Peso Total (ton)",
            "expression": [
              "DIVIDE(SUM(Spools[Peso_kg]), 1000)"
            ],
            "formatString": "#,0.000",
            "displayFolder": "1 Escopo"
          },
          {
            "name": "Qtd Spools",
            "expression": [
              "COUNTROWS(Spools)"
            ],
            "formatString": "#,0",
            "displayFolder": "1 Escopo"
          },
          {
            "name": "Qtd Nao Iniciados",
            "expression": [
              "CALCULATE(COUNTROWS(Spools), Spools[CodStatusMon] = \"36\")"
            ],
            "formatString": "#,0",
            "displayFolder": "1 Escopo"
          },
          {
            "name": "Peso Nao Iniciado (ton)",
            "expression": [
              "DIVIDE(CALCULATE(SUM(Spools[Peso_kg]), Spools[CodStatusMon] = \"36\"), 1000)"
            ],
            "formatString": "#,0.000",
            "displayFolder": "1 Escopo"
          },
          {
            "name": "% Nao Iniciado",
            "expression": [
              "DIVIDE([Peso Nao Iniciado (ton)], [Peso Total (ton)])"
            ],
            "formatString": "0.0%",
            "displayFolder": "1 Escopo"
          },
          {
            "name": "Avanco Acumulado (ton)",
            "expression": [
              "SUM(Avanco_Unidade[Ton_Acumulado])"
            ],
            "formatString": "#,0.000",
            "displayFolder": "2 Avanco"
          },
          {
            "name": "Avanco no Mes (ton)",
            "expression": [
              "VAR OrdemAtual = MAX(Meses[Ordem])",
              "VAR Atual = [Avanco Acumulado (ton)]",
              "VAR Anterior =",
              "    CALCULATE(",
              "        SUM(Avanco_Unidade[Ton_Acumulado]),",
              "        ALL(Meses),",
              "        Meses[Ordem] = OrdemAtual - 1",
              "    )",
              "RETURN",
              "    Atual - Anterior"
            ],
            "formatString": "#,0.000",
            "displayFolder": "2 Avanco"
          },
          {
            "name": "Saldo a Realizar (ton)",
            "expression": [
              "[Peso Total (ton)] - [Avanco Acumulado (ton)]"
            ],
            "formatString": "#,0.000",
            "displayFolder": "2 Avanco"
          },
          {
            "name": "% Avanco",
            "expression": [
              "DIVIDE([Avanco Acumulado (ton)], [Peso Total (ton)])"
            ],
            "formatString": "0.0%",
            "displayFolder": "2 Avanco"
          },
          {
            "name": "Ultimo Mes",
            "expression": [
              "MAXX(ALLSELECTED(Meses), Meses[Ordem])"
            ],
            "formatString": "#,0",
            "displayFolder": "2 Avanco"
          },
          {
            "name": "Fabricado Acumulado (ton)",
            "expression": [
              "CALCULATE(SUM(Avanco_Unidade[Ton_Acumulado]), ALL(Etapas), Etapas[Etapa] = \"Fabricado\")"
            ],
            "formatString": "#,0.000",
            "displayFolder": "2 Avanco"
          },
          {
            "name": "Liberado END Acumulado (ton)",
            "expression": [
              "CALCULATE(SUM(Avanco_Unidade[Ton_Acumulado]), ALL(Etapas), Etapas[Etapa] = \"Liberado END\")"
            ],
            "formatString": "#,0.000",
            "displayFolder": "2 Avanco"
          },
          {
            "name": "Fabricado (ton)",
            "expression": [
              "CALCULATE(",
              "    SUM(Avanco_Unidade[Ton_Acumulado]),",
              "    Meses[Ordem] = [Ultimo Mes],",
              "    ALL(Etapas),",
              "    Etapas[Etapa] = \"Fabricado\"",
              ")"
            ],
            "formatString": "#,0.000",
            "displayFolder": "3 Posicao atual"
          },
          {
            "name": "Soldado (ton)",
            "expression": [
              "CALCULATE(",
              "    SUM(Avanco_Unidade[Ton_Acumulado]),",
              "    Meses[Ordem] = [Ultimo Mes],",
              "    ALL(Etapas),",
              "    Etapas[Etapa] = \"Soldado\"",
              ")"
            ],
            "formatString": "#,0.000",
            "displayFolder": "3 Posicao atual"
          },
          {
            "name": "Liberado END (ton)",
            "expression": [
              "CALCULATE(",
              "    SUM(Avanco_Unidade[Ton_Acumulado]),",
              "    Meses[Ordem] = [Ultimo Mes],",
              "    ALL(Etapas),",
              "    Etapas[Etapa] = \"Liberado END\"",
              ")"
            ],
            "formatString": "#,0.000",
            "displayFolder": "3 Posicao atual"
          },
          {
            "name": "Teste Hidrostatico (ton)",
            "expression": [
              "CALCULATE(",
              "    SUM(Avanco_Unidade[Ton_Acumulado]),",
              "    Meses[Ordem] = [Ultimo Mes],",
              "    ALL(Etapas),",
              "    Etapas[Etapa] = \"Teste Hidrostático\"",
              ")"
            ],
            "formatString": "#,0.000",
            "displayFolder": "3 Posicao atual"
          },
          {
            "name": "% Fabricado",
            "expression": [
              "DIVIDE([Fabricado (ton)], [Peso Total (ton)])"
            ],
            "formatString": "0.0%",
            "displayFolder": "3 Posicao atual"
          },
          {
            "name": "% Concluido (Liberado END)",
            "expression": [
              "DIVIDE([Liberado END (ton)], [Peso Total (ton)])"
            ],
            "formatString": "0.0%",
            "displayFolder": "3 Posicao atual"
          },
          {
            "name": "Avanco SOP (ton)",
            "expression": [
              "SUM(Avanco_SOP[Ton_Acumulado])"
            ],
            "formatString": "#,0.000",
            "displayFolder": "4 SOP"
          },
          {
            "name": "Peso Liberado SOP (ton)",
            "expression": [
              "SUM(Ranking_SOP[Peso Liberado (ton)])"
            ],
            "formatString": "#,0.000",
            "displayFolder": "4 SOP"
          },
          {
            "name": "% Medio Avanco SOP",
            "expression": [
              "DIVIDE(AVERAGE(Ranking_SOP[% Liberado]), 100)"
            ],
            "formatString": "0.0%",
            "displayFolder": "4 SOP"
          },
          {
            "name": "Fabricado por Material (ton)",
            "expression": [
              "SUM(Material_Fabricado[Ton_Fabricado_Acumulado])"
            ],
            "formatString": "#,0.000",
            "displayFolder": "5 Material"
          },
          {
            "name": "Dias Medios",
            "expression": [
              "AVERAGE(Tempo_Medio[Dias])"
            ],
            "formatString": "#,0.0",
            "displayFolder": "5 Material"
          },
          {
            "name": "Juntas Total",
            "expression": [
              "SUM(Juntas_KPIs[Juntas (total)])"
            ],
            "formatString": "#,0",
            "displayFolder": "6 Juntas"
          },
          {
            "name": "Juntas Soldadas",
            "expression": [
              "SUM(Juntas_KPIs[Soldadas])"
            ],
            "formatString": "#,0",
            "displayFolder": "6 Juntas"
          },
          {
            "name": "Juntas Liberadas END",
            "expression": [
              "SUM(Juntas_KPIs[Liberadas END])"
            ],
            "formatString": "#,0",
            "displayFolder": "6 Juntas"
          },
          {
            "name": "% Juntas Soldadas",
            "expression": [
              "DIVIDE([Juntas Soldadas], [Juntas Total])"
            ],
            "formatString": "0.0%",
            "displayFolder": "6 Juntas"
          },
          {
            "name": "% Juntas Liberadas END",
            "expression": [
              "DIVIDE([Juntas Liberadas END], [Juntas Total])"
            ],
            "formatString": "0.0%",
            "displayFolder": "6 Juntas"
          },
          {
            "name": "Reparos",
            "expression": [
              "SUM(Juntas_KPIs[Reparos 1a])"
            ],
            "formatString": "#,0",
            "displayFolder": "6 Juntas"
          },
          {
            "name": "% Reparo",
            "expression": [
              "DIVIDE([Reparos], [Juntas Soldadas])"
            ],
            "formatString": "0.0%",
            "displayFolder": "6 Juntas"
          },
          {
            "name": "Juntas Acumuladas",
            "expression": [
              "SUM(Juntas_Curva[Juntas])"
            ],
            "formatString": "#,0",
            "displayFolder": "6 Juntas"
          },
          {
            "name": "Juntas Soldadas por Material",
            "expression": [
              "SUM(Juntas_Material[Juntas Soldadas])"
            ],
            "formatString": "#,0",
            "displayFolder": "6 Juntas"
          },
          {
            "name": "% Pintura",
            "expression": [
              "DIVIDE(SUM(KPIs[Pintura Realizada (m2)]), SUM(KPIs[Pintura Prevista (m2)]))"
            ],
            "formatString": "0.0%",
            "displayFolder": "7 Acabamento"
          },
          {
            "name": "% Isolamento",
            "expression": [
              "DIVIDE(SUM(KPIs[Isolamento Realizado (m2)]), SUM(KPIs[Isolamento Previsto (m2)]))"
            ],
            "formatString": "0.0%",
            "displayFolder": "7 Acabamento"
          },
          {
            "name": "% Peso com STH",
            "expression": [
              "DIVIDE(SUM(KPIs[% Peso com STH]), 100)"
            ],
            "formatString": "0.0%",
            "displayFolder": "7 Acabamento"
          }
        ]
      }
    ],
