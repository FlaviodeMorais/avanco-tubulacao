    "expressions": [
      {
        "name": "FonteDados",
        "kind": "m",
        "expression": [
          "\"https://avanco-tubulacao.vercel.app\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navegação"
          },
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "fnCarregar",
        "kind": "m",
        "expression": [
          "let",
          "    fnCarregar = (arquivo as text) as record =>",
          "        let",
          "            Conteudo =",
          "                if Text.StartsWith(Text.Lower(FonteDados), \"http\")",
          "                then Web.Contents(FonteDados, [RelativePath = arquivo])",
          "                else File.Contents(",
          "                    FonteDados",
          "                    & (if Text.EndsWith(FonteDados, \"\\\") then \"\" else \"\\\")",
          "                    & arquivo",
          "                ),",
          "            Documento = Json.Document(Conteudo, 65001)",
          "        in",
          "            Documento",
          "in",
          "    fnCarregar"
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navegação"
          },
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"FonteDados\", \"fnCarregar\", \"Meses\", \"Etapas\", \"Unidades\", \"Materiais\", \"Avanco_Unidade\", \"Avanco_SOP\", \"Spools\", \"Ranking_SOP\", \"Ranking_Linhas\", \"Material_Fabricado\", \"Tempo_Medio\", \"KPIs\", \"Juntas_KPIs\", \"Soldadores\", \"Reparos_Diametro\", \"Juntas_Curva\", \"Juntas_Material\", \"Medidas\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBIDesktopVersion",
        "value": "2.140.1454.0 (25.08)"
      }
    ]
  }
